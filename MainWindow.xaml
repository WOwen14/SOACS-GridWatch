<Window x:Class="SOACS.GridWatch.MainWindow" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:SOACS.GridWatch.Models" Title="SOACS GridWatch" Icon="Assets/AppIcon.ico" Height="900" Width="1440" MinWidth="1100" MinHeight="700" WindowState="Maximized" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#071722"/><Setter Property="Foreground" Value="#D8FBFF"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#113F4D"/><Setter Property="RowBackground" Value="#082232"/><Setter Property="AlternatingRowBackground" Value="#061926"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="AlternationCount" Value="2"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#082232"/><Setter Property="Foreground" Value="#00E5FF"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderBrush" Value="#00E5FF"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="#082232"/>
      <Setter Property="Foreground" Value="#D8FBFF"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Style.Triggers>
        <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#061926"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#00E5FF"/><Setter Property="Background" Value="#0B2A3A"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="#33FF85"/><Setter Property="Background" Value="#0D2B3A"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ScannerProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="12"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Foreground" Value="#00E5FF"/>
      <Setter Property="Background" Value="#02080D"/>
      <Setter Property="BorderBrush" Value="#00E5FF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="126"/><RowDefinition Height="106"/><RowDefinition Height="*"/><RowDefinition Height="126"/><RowDefinition Height="44"/></Grid.RowDefinitions>
    <Border Grid.Row="0" CornerRadius="8" BorderBrush="#00E5FF" BorderThickness="1" Background="#071019" Padding="10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
        <Image Source="Assets/Logo.png" Width="104" Height="104" Stretch="Uniform"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="SOACS GRIDWATCH" FontSize="32" Foreground="#00E5FF" FontFamily="Consolas" FontWeight="Bold"/><TextBlock Text="NETWORK OPERATIONS MONITOR" FontSize="16"/><TextBlock Text="Profile timing: Critical = 2 sec   |   High = 5 sec   |   Normal = 10 sec   |   Low = 30 sec" Margin="0,10,0,0" Foreground="#8FEFFF"/></StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="SYSTEM CLOCK" Foreground="#00E5FF" HorizontalAlignment="Right"/><TextBlock Text="{Binding ClockText}" FontSize="28" Foreground="#33FF85" FontWeight="Bold" FontFamily="Consolas"/><TextBlock Text="v1.0 RC2" Foreground="#8FEFFF" HorizontalAlignment="Right" Margin="0,4,0,2"/>
          <Button Content="SUMMARY MODE" Click="SummaryMode_Click"/></StackPanel>
      </Grid>
    </Border>
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,10" VerticalAlignment="Stretch">
      <Border CornerRadius="8" BorderBrush="#00E5FF" BorderThickness="1" Margin="4" Padding="8"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="ONLINE" Foreground="#00E5FF" HorizontalAlignment="Center"/><TextBlock Text="{Binding OnlineCount}" FontSize="28" Foreground="#33FF85" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
      <Border CornerRadius="8" BorderBrush="#00E5FF" BorderThickness="1" Margin="4" Padding="8"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="OFFLINE" Foreground="#00E5FF" HorizontalAlignment="Center"/><TextBlock Text="{Binding OfflineCount}" FontSize="28" Foreground="#FF3366" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
      <Border CornerRadius="8" BorderBrush="#00E5FF" BorderThickness="1" Margin="4" Padding="8"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="WARNINGS" Foreground="#00E5FF" HorizontalAlignment="Center"/><TextBlock Text="{Binding WarningCount}" FontSize="28" Foreground="#FFD34D" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
      <Border CornerRadius="8" BorderBrush="#00E5FF" BorderThickness="1" Margin="4" Padding="8"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="ENABLED" Foreground="#00E5FF" HorizontalAlignment="Center"/><TextBlock Text="{Binding EnabledCount}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
    </UniformGrid>
    <TabControl Grid.Row="2" Background="#050B10">
      <TabItem Header="Dashboard">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"><Button Content="＋ ADD TARGET" Click="AddTarget_Click"/><Button Content="－ REMOVE TARGET" Click="RemoveTarget_Click"/><Button Content="⧉ DUPLICATE" Click="DuplicateTarget_Click"/><Button Content="⌕ DISCOVER NETWORK" Click="Discover_Click"/></StackPanel>
          <DataGrid ItemsSource="{Binding Targets}" 
                    SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" 
                    SelectionMode="Single"
                    IsReadOnly="False"
                    KeyboardNavigation.TabNavigation="Continue"
                    KeyboardNavigation.DirectionalNavigation="Continue">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="STATUS" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Width="28" Height="28" Stroke="#D8FBFF" Fill="{Binding StatusBrush}" ToolTip="{Binding StatusToolTip}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="ON/OFF" Width="86"><DataGridTemplateColumn.CellTemplate><DataTemplate><ToggleButton Style="{StaticResource SpifToggleSwitch}" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="NAME" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
              <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
              <DataGridTemplateColumn Header="MONITOR" Width="130" IsReadOnly="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.MonitorTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding Monitor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="True"
                              Focusable="True"
                              IsTabStop="True"
                              HorizontalContentAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="PORT" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding PortEntryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPortEditable}" HorizontalContentAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="PROFILE" Width="130" IsReadOnly="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.ProfileTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding Profile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="True"
                              Focusable="True"
                              IsTabStop="True"
                              HorizontalContentAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="RESPONSE" Binding="{Binding Response}" IsReadOnly="True" Width="170"/>
              <DataGridTemplateColumn Header="NEXT" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><ProgressBar Style="{StaticResource ScannerProgress}" IsIndeterminate="False" Value="{Binding NextProgress}"/><TextBlock Text="{Binding NextText}" HorizontalAlignment="Center" FontSize="11" Foreground="#8FEFFF"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="UPTIME" Binding="{Binding History}" IsReadOnly="True" Width="110"/>
              <DataGridTemplateColumn Header="MANUAL" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="CHECK" Click="CheckOne_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Details / Logs">
        <Grid Margin="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" CornerRadius="10" BorderBrush="#00E5FF" BorderThickness="1" Padding="14" Margin="0,0,12,0" Background="#071019">
            <StackPanel>
              <TextBlock Text="SELECTED TARGET DETAILS" FontSize="22" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,14"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                  <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="State" Foreground="#00E5FF"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTarget.StateText}" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" Foreground="#00E5FF"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTarget.Name}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Address" Foreground="#00E5FF"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTarget.Address}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Monitor" Foreground="#00E5FF"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTarget.MonitorText}"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Profile" Foreground="#00E5FF"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTarget.ProfileText}"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Poll" Foreground="#00E5FF"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedTarget.PollSeconds, StringFormat={}{0} sec}"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Last Seen" Foreground="#00E5FF"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedTarget.LastSeenText}"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Text="RX Packets" Foreground="#00E5FF"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedTarget.RxPackets}"/>
              </Grid>
              <TextBlock Text="Select a row on the Dashboard to update these details." Foreground="#8FEFFF" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" CornerRadius="10" BorderBrush="#00E5FF" BorderThickness="1" Padding="10" Background="#071019">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="SELECTED TARGET LOG" FontSize="20" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,8"/>
              <ListBox ItemsSource="{Binding SelectedTargetLog}" Background="#02080D" Foreground="#D8FBFF" BorderBrush="#113F4D" FontFamily="Consolas"/>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Settings"><StackPanel Margin="18"><TextBlock Text="Settings" FontSize="24" Foreground="#00E5FF"/><TextBlock Text="Default timeout is 1000 ms. ICMP does not use ports. TCP and UDP require a port." Margin="0,12,0,0"/></StackPanel></TabItem>
      <TabItem Header="About">
        <Grid Margin="18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" CornerRadius="10" BorderBrush="#00E5FF" BorderThickness="1" Background="#071019" Padding="12" Margin="0,0,18,0">
            <Image Source="Assets/Logo.png" Stretch="Uniform"/>
          </Border>

          <Border Grid.Column="1" CornerRadius="10" BorderBrush="#00E5FF" BorderThickness="1" Background="#071019" Padding="18">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="SOACS GridWatch" FontSize="28" Foreground="#00E5FF" FontWeight="Bold"/>
              <TextBlock Text="Version 1.0 RC2" FontSize="16" Foreground="#8FEFFF" Margin="0,8,0,0"/>
              <TextBlock Text="Network Operations Monitor" FontSize="18" Margin="0,10,0,18"/>
              <TextBlock Text="Purpose-built for quick network health visibility, target monitoring, discovery, and compact status display." TextWrapping="Wrap" Margin="0,0,0,20"/>

              <UniformGrid Columns="2" Margin="0,4,0,0">
                <Button Content="OPERATOR GUIDE" Click="OperatorGuide_Click"/>
                <Button Content="HELP" Click="Help_Click"/>
                <Button Content="WHAT'S NEW" Click="WhatsNew_Click"/>
                <Button Content="OPEN CONFIG FOLDER" Click="OpenConfigFolder_Click"/>
              </UniformGrid>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" CornerRadius="8" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,10,0,8" Padding="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="EVENT TIMELINE" FontSize="20" FontWeight="Bold" Foreground="#00E5FF"/><ListBox ItemsSource="{Binding EventLog}" Background="#02080D" Foreground="#D8FBFF" BorderBrush="#00E5FF" FontFamily="Consolas"/></DockPanel></Border>
    <StackPanel Grid.Row="4" Orientation="Horizontal">
      <Button Content="▶ START" Click="Start_Click" IsEnabled="{Binding CanStart}" Background="{Binding StartButtonBrush}" Foreground="{Binding StartButtonTextBrush}"/>
      <Button Content="■ STOP" Click="Stop_Click" IsEnabled="{Binding CanStop}" Background="{Binding StopButtonBrush}" Foreground="{Binding StopButtonTextBrush}"/>
      <Button Content="↻ CHECK ALL" Click="CheckAll_Click"/>
      <Button Content="💾 SAVE CONFIG" Click="Save_Click"/>
      <Button Content="📂 LOAD CONFIG" Click="Load_Click"/>
      <Button Content="CLEAR LOG" Click="ClearLog_Click"/>
      <TextBlock Text="{Binding EngineHealthText}" Foreground="{Binding EngineStatusBrush}" VerticalAlignment="Center" Margin="10,0"/>
    </StackPanel>
  </Grid>
</Window>
